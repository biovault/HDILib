#version 430

// This should be invoked to parallelise calculation of the
// field pixel values one field pixel per subgroup (warp)
// The dispatching is indirect w.r.t. a dispatch tensor.
// See compute_field_workgroup.comp for the calculation 
#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ActivePixels {
    uvec2 activePixels[];
};

layout(std430, binding = 1) readonly buffer ActiveCount {
    uint activeCount;
};

layout(std430, binding = 2) readonly buffer Positions {
    vec2 positions[];
};

layout(std430, binding = 3) readonly buffer BoundsInterface { 
    vec2 Bounds[]; 
};

layout(rgba32f, binding = 4) writeonly uniform image2D Fields;

layout(scalar, binding = 5) uniform FieldPushConstants {
    uint num_points;
    vec2 imageSize;
    float support;  
} pc;

#define TILE_SIZE 4096
#define THREADS_PER_WORKGROUP 512

shared vec2 sharedPositions[TILE_SIZE];


void main() {
    uint tid = gl_LocalInvocationIndex;
    uint lane = gl_SubgroupInvocationID;
    uint lanes = gl_SubgroupSize;                // Runtime value
    uint numSubgroups = gl_NumSubgroups;         // Runtime value
    float res_x = 0.0;
    float res_y = 0.0;
    float res_z = 0.0;
    // Need to invoke enough workgroups to ensure that each active pixel has a 
    // subgroup available
    // i.e.: (activePixels + (numSubgroups-1))/numSubgroups
    //
    // Pixel index calculated using RUNTIME subgroup values
    // gl_WorkGroupID.x * numSubgroups gives the first pixel in this workgroup
    // gl_SubgroupID offsets to this subgroup's pixel
    uint pixelIndex = gl_WorkGroupID.x * numSubgroups + gl_SubgroupID;

    bool activeSubgroup = (pixelIndex < activeCount);

    vec2 min_bounds = Bounds[0];
    vec2 max_bounds = Bounds[1];
    vec2 range = max_bounds - min_bounds;

    vec2 pixelCoord = vec2(0.0);
    vec2 pixel_pos = vec2(0.0);
    if (activeSubgroup) {
        pixelCoord = vec2(activePixels[pixelIndex]);
        pixel_pos = (((pixelCoord + vec2(0.5)) / pc.imageSize) * range) + min_bounds;
    }

    uint numTiles = (pc.num_points + TILE_SIZE - 1) / TILE_SIZE;

    for (uint tileIdx = 0; tileIdx < numTiles; tileIdx++) {
        uint pointBase = tileIdx * TILE_SIZE;
        uint curTileSize = min(TILE_SIZE, pc.num_points - pointBase);

        // All threads load
        for (uint i = tid; i < curTileSize; i += THREADS_PER_WORKGROUP) {
            sharedPositions[i] = positions[pointBase + i];
        }
        barrier();

        if (activeSubgroup) {
            vec3 lane_accum = vec3(0.0);

            for (uint i = lane; i < curTileSize; i += lanes) {
                vec2 diff = pixel_pos - sharedPositions[i];
                float dot_val = fma(diff.x, diff.x, fma(diff.y, diff.y, 1.0));
                float tstud = 1.0 / dot_val;
                float tstud2 = tstud * tstud;

                lane_accum.x += tstud;
                lane_accum.y = fma(tstud2, diff.x, lane_accum.y);
                lane_accum.z = fma(tstud2, diff.y, lane_accum.z);
            }

            res_x += subgroupAdd(lane_accum.x);
            res_y += subgroupAdd(lane_accum.y);
            res_z += subgroupAdd(lane_accum.z);
        }

        barrier();
    }

    if (activeSubgroup && subgroupElect()) {
        imageStore(Fields, ivec2(pixelCoord), vec4(res_x, res_y, res_z, 0.0));
    }
}