// vectorized implementation
void main() {
    uint workGroupID = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint i = workGroupID * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    if (i >= pc.num_points)
        return;

    vec2 grad = Gradients[i];
    vec2 pgrad = PrevGradients[i];
    vec2 gain = Gain[i];

    // Vectorized gain update - uses component-wise comparison
    bvec2 signsDiffer = notEqual(sign(grad), sign(pgrad));
    gain = mix(gain * 0.8, gain + 0.2, signsDiffer);
    gain = max(gain, vec2(pc.minGain));

    vec2 etaGain = pc.eta * gain;
    
    // Vectorized gradient normalization
    grad = sign(grad) * abs(grad * etaGain) / etaGain;
    
    float momentum = (pc.iter < pc.mom_iter ? pc.mom : pc.final_mom);
    pgrad = momentum * pgrad - etaGain * grad;

    Gain[i] = gain;
    PrevGradients[i] = pgrad;
    Positions[i] += pgrad * pc.mult;
}